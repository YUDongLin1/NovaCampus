# =============================================================================
# NovaAgent 环境变量模板
# -----------------------------------------------------------------------------
# 使用方法（三步）：
#   1. 复制本文件为 .env          cp .env.example .env      （Windows: copy .env.example .env）
#   2. 填入你自己的 API Key（下面标了「必填」的至少两项）
#   3. 重新启动服务。改了 .env 必须**重启进程**才生效（容器要 up -d 而不是 restart）
#
# ⚠ 安全须知
#   · .env 已被 .gitignore 忽略，**永远不要**把它提交到 Git，也不要粘贴进 issue/截图。
#   · 本文件（.env.example）只放占位符，**不放任何真实 Key**。
#   · 一旦怀疑 Key 泄露：立刻去服务商控制台**吊销并重新生成**（删文件不算修复）。
#
# ⚠ 加载机制说明（本项目不依赖 python-dotenv）
#   读取优先级：操作系统环境变量 > 本文件 > 代码内默认值。
#   解析规则很朴素：每行 `KEY=VALUE`，以 # 开头的行为注释。
#   因此：**不要**写引号、不要写 export、值里不要有行尾注释。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、必填项 —— 缺任一项服务会拒绝启动
#     报错信息形如：RuntimeError: 缺少配置项: ['LLM_API_KEY']（检查 novaagent/.env）
# -----------------------------------------------------------------------------

# 对话模型（OpenAI 兼容接口）。默认对接阿里云百炼 DashScope 兼容模式。
# 去 https://bailian.console.aliyun.com/ 创建 API-KEY，形如 sk-xxxxxxxx
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash

# 向量模型（Embedding）。默认对接硅基流动 SiliconFlow。
# 去 https://cloud.siliconflow.cn/account/ak 创建密钥，形如 sk-xxxxxxxx
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3


# -----------------------------------------------------------------------------
# 二、检索质量相关 —— 不填也能跑，但检索效果会明显变差
# -----------------------------------------------------------------------------

# 重排模型（Rerank）。留空则「有向量、无重排」，召回会变差。
# 通常与 EMBEDDING_API_KEY 用同一把 SiliconFlow 密钥。
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3


# -----------------------------------------------------------------------------
# 三、周报 MCP 服务地址
#     ⚠ 这个服务**不是可选的**：NovaAgent 启动时会连接它，连不上则服务起不来
#       （fastapi lifespan 里没有容错）。启动周报服务的方法见 README「快速开始」。
#     默认值对应 `WEEKLY_PORT=18080` 的本地运行方式。
# -----------------------------------------------------------------------------
WEEKLY_MCP_URL=http://127.0.0.1:18080/mcp


# -----------------------------------------------------------------------------
# 四、本地数据目录 —— 存放 SQLite 库（会话、用户、知识库分块）
#     默认 novaagent/data，已被 .gitignore 忽略。
#     新克隆的仓库这里是**空的**：知识库没有任何文档，需自行上传。
# -----------------------------------------------------------------------------
# NOVA_DATA_DIR=


# =============================================================================
# 五、进阶开关（全部有默认值，零基础用户可整段不动）
# =============================================================================

# ---- 检索编排（LangGraph 状态机 + 查询改写）----
# 关掉可退回「无编排」的老路径，便于 A/B 对照
# NOVA_GRAPH_ENABLED=1
# 查询改写最大重试次数
# NOVA_MAX_REWRITE=2
# 召回达标判定：top 分数 ≥ GRADE_MIN_SCORE 且达标条数 ≥ GRADE_MIN_ABOVE
# NOVA_GRADE_MIN_SCORE=0.3
# NOVA_GRADE_MIN_ABOVE=2
# 融合层候选条数
# NOVA_FUSION_TOP_K=12

# ---- 拒答门控（库里没据时就拒答，不让模型自由发挥）----
# 重排原始分低于该值不作为回答依据
# NOVA_RERANK_MIN_SCORE=0.3   ← 实际由 config.RERANK_MIN_SCORE 常量控制，暂未开放为环境变量
# 单来源放行线：只有 1 条达标来源时，分数 ≥ 该值才放行
# NOVA_REFUSAL_SINGLE_SOURCE_MIN_SCORE=0.9
# 术语展开停用词开关
# NOVA_KEYWORD_STOPWORDS=1

# ---- 流式回答的 grounding 闸门 ----
# 早窗字符数：前 N 字内还没出现可核查事实（引用编号或数字）就先缓冲
# NOVA_GROUNDING_EARLY_WINDOW_CHARS=80
# 闸门总开关（0 = 关闭，退回未加闸门时的行为）
# NOVA_GROUNDING_GATE=1
# 闸门作用范围：factual_turns(只对需要事实的轮次生效) / all_turns(退回旧行为)
# NOVA_GROUNDING_GATE_SCOPE=factual_turns
# ⚠ 测试钩子，默认关：强制把流式首版判为「无据」，用于断言重生通道必然被执行
# NOVA_GROUNDING_STREAM_FORCE_UNGROUNDED=0

# ---- 联网搜索（默认关闭；开启后仅在本地库无据时才出网）----
# NOVA_WEB_SEARCH_ENABLED=0
# 空闲/读超时（秒）：两次数据之间的最大间隔
# NOVA_WEB_SEARCH_IDLE_TIMEOUT_S=20
# 总时限（秒）：无论上游是否持续吐数据，到点必断
# NOVA_WEB_SEARCH_TOTAL_TIMEOUT_S=45
# 最多返回来源数
# NOVA_WEB_SEARCH_MAX_SOURCES=8
# 联网搜索需要额外配置独立的搜索服务，见 README「配置说明」

# ---- 会议纪要：录音转写（ASR）----
# 链路：百炼「上传本地文件获取临时 URL」→ 录音文件识别异步任务（提交 → 轮询 → 取结果）。
# ⚠ 隐私：上传录音会把**会议音频**发往 DashScope；整理会把**会议原文**发往 LLM。
#   两者都只在界面上勾选「同意发往外部模型」后才会发生，未勾选时按钮保持不可用。
# 总开关（0 = 关闭录音转写入口，只留粘贴文本与上传笔记）
# NOVA_ASR_ENABLED=1
# 转写模型。必须是「中国内地（北京）」地域 API Key 可用的模型；
# 上传凭证与模型调用必须用同一个主账号、同一个模型名（文件与模型绑定）。
# NOVA_ASR_MODEL=paraformer-v2
# 说话人分离（默认关）。开启后官方建议音频 ≤2 小时，且识别失败率上升。
# NOVA_ASR_DIARIZATION=0
# 指定说话人数（0 = 不指定，交给模型自动判）
# NOVA_ASR_SPEAKER_COUNT=0
# 单个音频大小上限（MB）。官方上限 2GB，这里按单机自用收紧。
# NOVA_ASR_MAX_MB=200
# 轮询间隔（秒）
# NOVA_ASR_POLL_INTERVAL_S=3
# 转写总时限（秒）：提交 + 轮询 + 取结果的整体上限，到点必断
# NOVA_ASR_TOTAL_TIMEOUT_S=900
# DashScope 原生 REST 基址（注意：与上面 LLM_BASE_URL 的 compatible-mode 端点不是同一个）
# NOVA_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# ⚠ 临时存储的三条来自官方文档的限制，别当成可长期依赖的通道：
#   临时 URL 有效期 48 小时；上传凭证接口限流 100 QPS 且不支持扩容；
#   官方明确「请勿用于生产环境」。本项目定位是辅导员单机自用，不是高并发服务端。

# ---- 评测专用（只影响 evals/ 与 tests/，不影响线上行为）----
# 评测时把采样温度压到 0，保证可复现
# NOVAAGENT_EVAL_TEMPERATURE=0
# 评测节流（毫秒）。免费通道建议 3000~5000，避免上游 429
# NOVA_EVAL_THROTTLE_MS=0
# 上线前自检用的「假 Key 护身符」：注入一个必然 401 的假值，
# 可以在不花额度的情况下验证链路是否真的没打到付费通道。
# LLM_API_KEY=ZERO-QUOTA-PROTECTOR-not-a-real-key
