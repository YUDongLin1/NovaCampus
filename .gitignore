# 上游开源底座(独立 git 仓库,锁定 tag v0.8.2;校园化定制在 weknora/ 内自建分支)
/weknora/

# 密钥与环境配置
.env
.env.*
!.env.example

# Python
__pycache__/
.venv/
*.pyc
.pytest_cache/

# Node
node_modules/
dist/

# 本地数据 / 日志 / 导出
data/
logs/
*.log
exports/
# 例外:验收证据留痕必须入库(否则 docs/P3A.md 第五节引用的 CLI 注入日志会静默丢失)
!docs/p3a/evidence/*.log
# 例外:P3b 证据留痕(step0 实时复跑 CLI 日志 + aiops_demo 端到端现场演示输出)
!docs/p3b/evidence/*.log
# 例外:P4 证据留痕(KB 清理与拒答门控实测的评测日志)
!docs/p4/evidence/*.log
# 例外:P4f 复核证据留痕(集中验证最小档三次的运行日志,含 env_flags 与逐用例读数)
!docs/p4f/evidence/*.log
!docs/p4f/evidence/review/*.log

# 语料脱敏前原始文件(只允许入库脱敏后的版本)
raw_docs/

# 学生事务库训练材料(第三方已发表内容「萌哥说案例」等 + 切分正文):
# 只本地导入 KB 支撑 demo,不进 git,避免将来公开发布时的版权顾虑
corpus/raw/affairs/
corpus/clean/affairs/

# 系统 / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# NovaAgent 本地产物
novaagent/.tmp-*
novaagent/.venv/
