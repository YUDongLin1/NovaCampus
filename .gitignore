# =============================================================================
# NovaCampus 智枢 Agent —— Git 忽略规则
# -----------------------------------------------------------------------------
# 组织方式：按「作用类别」分块，每块开头写明这类规则防的是什么。
# 维护约定：新增规则请写进最贴近的类别块；跨类别的通用规则放最后一节。
# 特别注意：带 ! 的例外规则必须写在**让文件被忽略的那条规则之后**，
#           否则不生效（Git 按最后一条匹配的规则取胜）。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 密钥与环境配置 —— 防的是「真实凭据进入公开仓库」
#    .env 系列是本项目唯一存放密钥的地方，一旦入库即为永久泄露（即使事后删除，
#    值仍留在 Git 历史与所有克隆里）。所有 .env 一律忽略，只放行模板文件。
#    本仓库已核验：.env 系列从未被提交过，请保持这个状态。
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example

# 证书与私钥：绝不允许入库（私钥入库等于交出身份）
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_ed25519

# 云厂商/服务的凭据文件常见命名
credentials.json
service-account*.json
*credentials*.json
secrets.json
secret.yaml
secret.yml


# -----------------------------------------------------------------------------
# 2. 本地审查与临时产物 —— 防的是「审查报告本身成为泄露源」
#    PRIVACY-AUDIT.local.md 里列出了真实密钥的位置与前缀；*.local.* 一律不入库。
# -----------------------------------------------------------------------------
*.local.md
*.local.*
PRIVACY-AUDIT*
.tmp-*
tmp/
*.tmp
*.temp
*~
*.orig
*.rej


# -----------------------------------------------------------------------------
# 3. 上游开源底座(独立 git 仓库,锁定 tag v0.8.2;校园化定制在 weknora/ 内自建分支)
#    142 MB 第三方源码，不随本仓库分发；使用者按 README 自行 clone。
#    同时这也把 weknora/.env（含真实密钥）一并挡在仓库之外。
# -----------------------------------------------------------------------------
/weknora/


# -----------------------------------------------------------------------------
# 4. Python —— 防的是「依赖、字节码、缓存、构建产物」
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
*.egg-info/
*.egg
.eggs/
build/
dist/
sdist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
site-packages/


# -----------------------------------------------------------------------------
# 5. Node / 前端构建产物 —— 防的是「依赖与打包结果」
#    本项目前端是零构建（原生 JS，直接由 FastAPI 托管），本节能防的是
#    将来引入构建链或被 weknora 带进来的 node_modules。
# -----------------------------------------------------------------------------
node_modules/
bower_components/
dist/
build/
.next/
.nuxt/
.output/
coverage/
*.tsbuildinfo
.npm/
.yarn/
.pnpm-store/


# -----------------------------------------------------------------------------
# 6. 本地数据 / 数据库 / 备份 —— 防的是「真实运行数据与个人聊天记录」
#    data/ 匹配任意层级，因此根目录 data/ 与 novaagent/data/ 都被覆盖。
#    ⚠ 这里装的是真实运营数据：novaagent/data/agent.db 含 2232 个会话 /
#      9812 条消息（辅导员真实使用痕迹），data/weekly/ 含真实工作记录。
#      —— 这也是为什么新克隆的仓库知识库是空的，属预期行为。
# -----------------------------------------------------------------------------
data/
# ⚠ 例外(重要,易踩):novaagent/novaagent/data/ 是**源码目录**而不是运行时目录——
#   里面的 contacts.json 是应用依赖的「部门联系表」,必须入库。
#   原 .gitignore 只有一条 `data/`,该文件一直处于「已跟踪但被忽略」的脆弱状态:
#   一旦它被删除,git add -A 不会把它加回来。这里显式豁免该目录。
!novaagent/novaagent/data/
!novaagent/novaagent/data/contacts.json
# 运行时数据库目录(与源码目录区分开)
novaagent/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.duckdb
*.parquet
*.bak
*.bak-*
*.backup


# -----------------------------------------------------------------------------
# 7. 日志与导出 —— 防的是「运行日志里混入密钥/个人信息」
#    默认忽略全部 *.log；下面按需放行少量**验收证据**日志（见第 8 节）。
# -----------------------------------------------------------------------------
logs/
*.log
*.out
exports/
*.pid
*.seed


# -----------------------------------------------------------------------------
# 8. 验收证据例外 —— 这些日志是项目验收的留痕，必须入库
#    缘由：.gitignore 的全局 *.log 曾把它们静默排除，导致 docs/ 里引用的
#    证据文件在别处克隆后「查无此文件」。例外必须逐目录显式放行。
# -----------------------------------------------------------------------------
!docs/p3a/evidence/*.log
!docs/p3b/evidence/*.log
!docs/p4/evidence/*.log
!docs/p4f/evidence/*.log
!docs/p4f/evidence/review/*.log
# 同上：.out 也是证据留痕（run_*.py.out 是复核脚本的原始输出）
!docs/**/evidence/*.out
!docs/**/evidence/**/*.out


# -----------------------------------------------------------------------------
# 9. 语料来源保护 —— 防的是「版权与真实学工数据」
#    raw_docs/                 = 脱敏前的原始抓取件
#    corpus/raw/affairs/       = 第三方已发表材料（「萌哥说案例」等）解包原件
#    corpus/clean/affairs/     = 上者的切分产物
#    只允许脱敏后的 policy/guide/ops 入库。
#    注意：这条规则只保护 Corpus 目录本身，其**衍生的证据 JSON** 仍需人工清理
#    （见 PRIVACY-AUDIT.local.md 的 P1-7）。
# -----------------------------------------------------------------------------
raw_docs/
corpus/raw/affairs/
corpus/clean/affairs/


# -----------------------------------------------------------------------------
# 10. IDE / 编辑器 —— 防的是「个人配置与本地路径」
# -----------------------------------------------------------------------------
.idea/
.vscode/
.fleet/
.zed/
.history/
*.swp
*.swo
*.sublime-workspace
*.sublime-project


# -----------------------------------------------------------------------------
# 11. 操作系统 —— 防的是「系统垃圾文件与元数据」
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/


# -----------------------------------------------------------------------------
# 12. AI 编码工具的工作目录 —— 防的是「工具缓存与本机路径」
#     注意：.zcodeignore 是**有意入库**的（它是本仓库的搜索忽略规则），
#     因此这里不忽略它。
# -----------------------------------------------------------------------------
.workbuddy/
.zcode/
.qoder/
.claude/
.cursor/
.aider*
.continue/


# -----------------------------------------------------------------------------
# 13. 项目本地产物（路径显式化，便于排查）
# -----------------------------------------------------------------------------
novaagent/.tmp-*
novaagent/.venv/
novaagent/data/
mcp/weekly/.venv/
mcp/weekly/data-weekly/
mcp/aiops/.venv/
reports/*.pid
